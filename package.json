{
  "name": "dsh-desktop-themes",
  "version": "1.8.0",
  "description": "DeepSeek Harness Desktop Themes — an installable, configurable, uninstallable desktop appearance plugin: six signature themes, font presets, live particle/glow effects, durable custom wallpaper, glassmorphism, custom color themes, and a draggable desktop pet with a quick-switch menu.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "theme",
    "font",
    "wallpaper",
    "glassmorphism"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/*.test.ts\"",
    "bench": "tsx scripts/bench.ts",
    "deploy:web": "node scripts/deploy-web.mjs --restart",
    "deploy:web:no-restart": "node scripts/deploy-web.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6 <0.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

{
  "name": "dsh-desktop-themes",
  "version": "3.0.0",
  "description": "DSH 工作环境：纸感、矿物、夜幕三套成品风格，独立工作模式与氛围、壁纸生成配色、可迁移风格包与专业主题工作室。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "theme",
    "font",
    "wallpaper",
    "glassmorphism"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES.md",
    "docs/workspace.md",
    "docs/screenshots/studio"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/*.test.ts\"",
    "audit:contrast": "tsx scripts/contrast-audit.ts",
    "audit:surfaces": "tsx scripts/surface-audit.ts",
    "audit": "npm run audit:contrast && npm run audit:surfaces",
    "install:desktop": "node scripts/install-desktop.mjs",
    "bench": "tsx scripts/bench.ts",
    "deploy:web": "node scripts/deploy-web.mjs --restart",
    "deploy:web:no-restart": "node scripts/deploy-web.mjs",
    "test:studio-browser": "node scripts/verify-studio.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6 <0.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
